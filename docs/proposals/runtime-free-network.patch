-    assert_eq!(response.body.as_ref(), b"hello world");
-    assert_eq!(
-        response
-            .headers
-            .get(reqwest::header::CONTENT_TYPE)
-            .and_then(|value| value.to_str().ok()),
-        Some("text/plain"),
-        "the content type encoded in the URL is the response's"
-    );
-}
-
-#[tokio::test]
-async fn a_base64_data_url_is_decoded() {
