[
    (
        id: "resource-policy-ready",
        group: "resource-policy",
        what: "the served browser page starts and paints its witness",
        open: None,
        hover: None,
        click: None,
        subject: "RESOURCE_POLICY_STARTED",
        expect: PaintsNamed,
        outcome_timeout_ms: 10000,
    ),
    (
        id: "resource-policy-request-cap",
        group: "resource-policy",
        what: "real sequential HTTP fetches stop at the application's per-document request cap",
        open: None,
        hover: None,
        click: None,
        subject: "READY: RESOURCE_POLICY request-cap PASS",
        expect: PaintsNamed,
        outcome_timeout_ms: 10000,
    ),
]
