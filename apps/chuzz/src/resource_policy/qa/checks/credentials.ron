[
    (
        id: "resource-policy-ready",
        group: "resource-policy",
        what: "the served browser page starts and paints its witness",
        open: None,
        hover: None,
        click: None,
        subject: "RESOURCE_POLICY_STARTED",
        expect: PaintsNamed,
        outcome_timeout_ms: 10000,
    ),
    (
        id: "resource-policy-credentials",
        group: "resource-policy",
