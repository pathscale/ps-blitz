// What a control bound to `false` reports before anything touches it.
//
// `checked` is an HTML boolean attribute, so reflecting a written `false` into
// it sets the input, and every controlled checkbox, radio and switch came up
// already selected whatever its state said.
[
    (
        id: "controlled-checkbox-paints",
        group: "controlled-checkbox",
        what: "the fixture builds and paints",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Controlled checkbox",
        expect: Present,
    ),
    (
        id: "controlled-checkbox-starts-off",
        group: "controlled-checkbox",
        what: "a control bound to false is not checked",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Reports off",
        expect: Present,
    ),
    (
        id: "controlled-checkbox-follows-the-property",
        group: "controlled-checkbox",
        what: "pressing it moves the state a component reads back",
        open: None,
        hover: None,
        settle_after_ms: 300,
        click: Some("checkbox:Controlled"),
        subject: "heading:Reports on",
        expect: Present,
    ),
    // The control, not the outcome text. A checkbox or radio has an
    // intrinsic box that owes nothing to a font, so this is the paint
    // assertion the rest of this file can no longer make: the checks above
    // read outcome text, and text measures 0x0 with no face registered.
    //
    // Without this, the group proves the tree is right and nothing about
    // whether the document rendered at all.
    (
        id: "controlled-checkbox-control-paints",
        group: "controlled-checkbox",
        what: "the control itself paints, with no font involved",
        open: None,
        hover: None,
        click: None,
        subject: "checkbox:Controlled",
        expect: PaintsNamed,
    ),
]
