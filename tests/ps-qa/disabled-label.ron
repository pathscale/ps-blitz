// A press on a label whose control is disabled.
//
// The two checks are a pair. "The disabled control heard nothing" is satisfied
// just as well by a press that never arrived, so the first one presses an
// enabled control the same way and requires that it did hear. Without it the
// second is vacuous, which is the failure this whole area is about.
[
    (
        id: "disabled-label-paints",
        group: "disabled-label",
        what: "the fixture builds and paints",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Disabled label",
        expect: Present,
    ),
    (
        id: "disabled-label-delivers-to-an-enabled-control",
        group: "disabled-label",
        what: "a press on a label reaches an enabled control",
        open: None,
        hover: None,
        settle_after_ms: 300,
        click: Some("#allowed-label"),
        subject: "heading:Allowed heard click",
        expect: Present,
    ),
    (
        id: "disabled-label-delivers-nothing-to-a-disabled-control",
        group: "disabled-label",
        what: "the same press reaches a disabled control not at all",
        open: None,
        hover: None,
        settle_after_ms: 300,
        click: Some("#off-limits-label"),
        subject: "heading:Disabled heard click",
        expect: Absent,
    ),
    // The control, not the outcome text. A checkbox or radio has an
    // intrinsic box that owes nothing to a font, so this is the paint
    // assertion the rest of this file can no longer make: the checks above
    // read outcome text, and text measures 0x0 with no face registered.
    //
    // Without this, the group proves the tree is right and nothing about
    // whether the document rendered at all.
    (
        id: "disabled-label-control-paints",
        group: "disabled-label",
        what: "the control itself paints, with no font involved",
        open: None,
        hover: None,
        click: None,
        subject: "checkbox:Allowed control",
        expect: PaintsNamed,
    ),
]
